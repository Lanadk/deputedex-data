{
  "name": "deputydex-data",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "first-setup": "npm run docker-image:build && npm run docker:db && npm run prisma:migrate-dev && npm run prisma:generate  && npm run prisma:seed",
    "build": "tsc --noEmit",
    "test": "jest --selectProjects unit",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:all": "jest --runInBand",
    "docker:db": "ts-node local/local-db-init.ts",
    "docker-image:build": "docker build -t deputydex-db-image .",
    "drop-views": "ts-node prisma/drop-views.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate-dev": "dotenv -e .env.local -- npx prisma migrate dev",
    "prisma:migrate-prod": "prisma migrate deploy",
    "prisma:seed": "ts-node --project tsconfig.json prisma/seed.ts",
    "prisma:pull": "prisma db pull",
    "prisma:reset": "npm run drop-views && dotenv -e .env.local -- npx prisma migrate reset"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "adm-zip": "^0.5.16",
    "dotenv": "^17.2.3",
    "pg": "^8.18.0",
    "pg-copy-streams": "^7.0.0",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.2.0",
    "@types/pg": "^8.16.0",
    "@types/pg-copy-streams": "^1.2.5",
    "dotenv-cli": "^11.0.0",
    "jest": "^30.4.2",
    "prisma": "^7.3.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  },
  "private": true
}
